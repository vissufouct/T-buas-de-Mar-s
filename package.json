{
  "name": "mares-mz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node --use-env-proxy server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --use-env-proxy server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build:pages": "VITE_FORECAST_MODE=direct npm run build",
    "preview:pages": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "leaflet": "^1.9.4",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/leaflet": "^1.9.15",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "@playwright/test": "^1.56.0"
  }
}
